          <div style={{background:"#333",color:"#fff",fontWeight:700,padding:"3px 8px",marginBottom:6,fontSize:11}}>Bill Details:</div>
          <div><b>Bill No:</b> {billNo}</div>
          <div><b>Date:</b> {billDate}</div>
          <div><b>Payment Due:</b> {dueDate}</div>
          <div><b>Payment Mode:</b> {payMode||order.paymentMethod||"—"}</div>
        </div>
      </div>

      {/* Measurements */}
      {measKeys.length>0&&(
        <>
          <div style={{background:"#ffe600",color:"#111",textAlign:"center",fontWeight:700,padding:"4px 0",fontSize:11,letterSpacing:1,borderBottom:"1px solid #ccc"}}>Measurement Details</div>
          <table style={{width:"100%",borderCollapse:"collapse",fontSize:11,borderBottom:"1px solid #ccc"}}>
            <thead>
              <tr style={{background:"#f5f5f5"}}>
                <th style={th}>Item</th>
                {measKeys.map(k=><th key={k} style={th}>{k}</th>)}
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style={td}>{order.design?.name||"Blouse"}</td>
                {measKeys.map(k=><td key={k} style={{...td,textAlign:"center"}}>{meas[k]}"</td>)}
              </tr>
            </tbody>
          </table>
        </>
      )}

      {/* Items table */}
      <table style={{width:"100%",borderCollapse:"collapse",fontSize:11,borderBottom:"1px solid #ccc",marginTop:2}}>
        <thead>
          <tr style={{background:"#222",color:"#fff"}}>
            {["Sl. No.","Description","Color / Fabric","Unit","Qty","Price/Unit","GST %","Amount"].map(h=>(
              <th key={h} style={{padding:"6px 8px",textAlign:["Qty","Price/Unit","GST %","Amount"].includes(h)?"right":"left",fontWeight:700,fontSize:10,letterSpacing:.5,border:"1px solid #444"}}>{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {items.map((it,i)=>{
            const amt=lineAmt(it)+lineGst(it);
            return(
              <tr key={i} style={{background:i%2===0?"#fff":"#fafafa"}}>
                <td style={td}>{it.sl}</td>
                <td style={{...td,fontWeight:600}}>{it.desc||"—"}</td>
                <td style={td}>{it.color||"—"}</td>
                <td style={td}>{it.unit}</td>
                <td style={{...td,textAlign:"right"}}>{it.qty}</td>
                <td style={{...td,textAlign:"right"}}>₹{parseFloat(it.price||0).toFixed(2)}</td>
                <td style={{...td,textAlign:"right"}}>{it.gstPct}%</td>
                <td style={{...td,textAlign:"right",fontWeight:700}}>₹{amt.toFixed(2)}</td>
              </tr>
            );
          })}
          {/* empty rows */}
          {Array.from({length:Math.max(0,4-items.length)}).map((_,i)=>(
            <tr key={`e${i}`} style={{background:i%2===0?"#fafafa":"#fff"}}>
              {Array(8).fill(0).map((_,j)=><td key={j} style={{...td,height:22}}>&nbsp;</td>)}
            </tr>
          ))}
        </tbody>
      </table>

      {/* Totals + notes */}
      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",borderBottom:"1px solid #ccc"}}>
        {/* Left: notes */}
        <div style={{borderRight:"1px solid #ccc"}}>
          <div style={{background:"#111",color:"#fff",fontWeight:700,padding:"4px 10px",fontSize:11}}>Special notes and instructions</div>
          <div style={{padding:"8px 10px",minHeight:48,color:"#555",fontSize:11,lineHeight:1.6}}>{notes||"—"}</div>
          <div style={{borderTop:"1px solid #ccc",padding:"6px 10px",display:"flex",justifyContent:"flex-end"}}>
            <div style={{background:"#ffe600",padding:"3px 16px",fontWeight:700,fontSize:11}}>Seal &amp; Signature</div>
          </div>
        </div>
        {/* Right: totals */}
        <div style={{padding:0}}>
          {[["Sub Total",`₹${subTotal.toFixed(2)}`],["GST Total",`₹${totalGst.toFixed(2)}`],["Discount",`₹${discAmt.toFixed(2)}`]].map(([l,v])=>(
            <div key={l} style={{display:"flex",justifyContent:"space-between",padding:"6px 14px",borderBottom:"1px solid #eee"}}>
              <span style={{color:"#555"}}>{l}</span><span style={{fontWeight:700}}>{v}</span>
            </div>
          ))}
          <div style={{display:"flex",justifyContent:"space-between",padding:"8px 14px",background:"#ffe600",fontWeight:900,fontSize:14}}>
            <span>Final Amount:</span><span>₹{finalAmt.toFixed(2)}</span>
          </div>
          {order.paidAt&&(
            <div style={{display:"flex",justifyContent:"center",padding:"6px",borderTop:"1px solid #ccc"}}>
              <div style={{border:"3px solid #4caf50",borderRadius:4,padding:"3px 14px",color:"#4caf50",fontWeight:900,fontSize:16,letterSpacing:3,transform:"rotate(-6deg)",display:"inline-block"}}>PAID ✓</div>
            </div>
          )}
        </div>
      </div>

      {/* Declaration */}
      <div style={{background:"#111",color:"#fff",fontWeight:700,padding:"4px 10px",fontSize:11}}>Declaration:</div>
      <div style={{padding:"6px 10px",fontSize:10,color:"#666",lineHeight:1.5,borderBottom:"1px solid #ccc"}}>{DECLARATION}</div>

      {/* Footer */}
      <div style={{background:"#ffe600",color:"#111",textAlign:"center",padding:"7px 0",fontWeight:800,fontSize:12}}>
        Thanks for business with us!!! Please visit us again !!!
      </div>
    </div>
  );

  const th={padding:"5px 8px",border:"1px solid #ccc",fontWeight:700,fontSize:10,textAlign:"center",background:"#f0f0f0"};
  const td={padding:"5px 8px",border:"1px solid #eee",fontSize:11};

  return (
    <div>
      {/* ── STAFF EDITOR ── */}
      {isStaff&&!order.paidAt&&(
        <div style={{background:"#0a0a0a",border:"1px solid #1a1a1a",borderRadius:14,padding:"18px 20px",marginBottom:18}}>
          <h4 style={{color:"#f4c060",fontWeight:700,fontSize:14,margin:"0 0 14px"}}>📝 Build Bill</h4>
          {/* item rows */}
          <div style={{overflowX:"auto",marginBottom:10}}>
            <table style={{width:"100%",borderCollapse:"collapse",minWidth:600}}>
              <thead>
                <tr style={{background:"#111"}}>
                  {["#","Description","Color/Fabric","Unit","Qty","Price/Unit","GST%","HSN",""].map(h=>(
                    <th key={h} style={{padding:"6px 8px",color:"#888",fontSize:10,fontWeight:700,letterSpacing:1,textAlign:"left",borderBottom:"1px solid #222"}}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {items.map((it,i)=>(
                  <tr key={i}>
                    <td style={{padding:"5px 6px",color:"#666",fontSize:12}}>{it.sl}</td>
                    <td style={{padding:"3px 4px"}}><input style={iS} value={it.desc} onChange={e=>updItem(i,"desc",e.target.value)} placeholder="Blouse Stitching"/></td>
                    <td style={{padding:"3px 4px"}}><input style={iS} value={it.color} onChange={e=>updItem(i,"color",e.target.value)} placeholder="Red Silk"/></td>
                    <td style={{padding:"3px 4px"}}><input style={{...iS,width:52}} value={it.unit} onChange={e=>updItem(i,"unit",e.target.value)}/></td>
                    <td style={{padding:"3px 4px"}}><input style={{...iS,width:44,textAlign:"center"}} type="number" min="1" value={it.qty} onChange={e=>updItem(i,"qty",e.target.value)}/></td>
                    <td style={{padding:"3px 4px"}}><input style={{...iS,width:72,textAlign:"right"}} type="number" min="0" step="0.01" value={it.price} onChange={e=>updItem(i,"price",e.target.value)} placeholder="0.00"/></td>
                    <td style={{padding:"3px 4px"}}><input style={{...iS,width:44,textAlign:"center"}} type="number" min="0" max="28" value={it.gstPct} onChange={e=>updItem(i,"gstPct",e.target.value)}/></td>
                    <td style={{padding:"3px 4px"}}><input style={{...iS,width:54}} value={it.hsn} onChange={e=>updItem(i,"hsn",e.target.value)}/></td>
                    <td style={{padding:"3px 4px"}}><button onClick={()=>delItem(i)} style={{background:"transparent",border:"none",color:"#f46060",cursor:"pointer",fontSize:15,lineHeight:1}}>✕</button></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <button onClick={addItem} style={{background:"transparent",border:"1px dashed #333",color:"#666",padding:"5px 14px",borderRadius:8,cursor:"pointer",fontSize:12,marginBottom:14}}>＋ Add Item</button>
          <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:12,marginBottom:12}}>
            <div>
              <label style={{color:"#666",fontSize:10,fontWeight:700,letterSpacing:1,textTransform:"uppercase",display:"block",marginBottom:5}}>Discount (₹)</label>
              <input style={iS} type="number" min="0" value={discount} onChange={e=>setDiscount(e.target.value)} placeholder="0"/>
            </div>
            <div>
              <label style={{color:"#666",fontSize:10,fontWeight:700,letterSpacing:1,textTransform:"uppercase",display:"block",marginBottom:5}}>Special Notes</label>
              <input style={iS} value={notes} onChange={e=>setNotes(e.target.value)} placeholder="e.g. Alterations included"/>
            </div>
          </div>
          <div style={{display:"flex",alignItems:"center",gap:16,flexWrap:"wrap"}}>
            <div style={{color:"#f4c060",fontWeight:800,fontSize:18}}>Final: ₹{finalAmt.toFixed(2)}</div>
            <button onClick={saveBill} style={{background:"linear-gradient(135deg,#f4c060,#c87820)",color:"#000",border:"none",padding:"10px 22px",borderRadius:10,fontSize:13,fontWeight:800,cursor:"pointer"}}>💾 Save Bill</button>
          </div>
        </div>
      )}

      {/* ── BILL PREVIEW ── */}
      <div style={{marginBottom:16}}><Bill/></div>

      {/* ── CUSTOMER PAYMENT ── */}
      {!isStaff&&!order.paidAt&&(
        <>
          <p style={{color:"#888",fontSize:13,marginBottom:10}}>Choose payment method:</p>
          <div style={{display:"flex",gap:10,flexWrap:"wrap",marginBottom:14}}>
            {["GPay","PhonePe","Cash"].map(m=>(
              <button key={m} onClick={()=>setPayMode(m)}
                style={{background:payMode===m?"#ffe600":"#111",color:payMode===m?"#111":"#888",border:`1px solid ${payMode===m?"#ffe600":"#222"}`,padding:"10px 20px",borderRadius:10,cursor:"pointer",fontWeight:700,fontSize:13}}>
                {m==="GPay"?"💙 GPay":m==="PhonePe"?"💜 PhonePe":"💵 Cash"}
              </button>
            ))}
          </div>
          {payMode&&payMode!=="Cash"&&(
            <div style={{marginBottom:12}}>
              <a href={`upi://pay?pa=${payMode==="GPay"?"gsquarefashion@okaxis":"gsquarefashion@ybl"}&pn=G+Square+Fashion&am=${finalAmt.toFixed(2)}&tn=Token+${order.token}`}
                style={{display:"inline-block",background:payMode==="GPay"?"#1a73e8":"#6739b7",color:"#fff",padding:"11px 22px",borderRadius:10,fontWeight:700,fontSize:14,textDecoration:"none"}}>
                {payMode==="GPay"?"💙 Open GPay":"💜 Open PhonePe"}
              </a>
            </div>
          )}
          {payMode&&(
            <>
              <ActionBtn onClick={()=>handlePaid(payMode)}>✅ Confirm Payment & Send Bill on WhatsApp →</ActionBtn>
              <p style={{color:"#555",fontSize:11,marginTop:6}}>📲 Bill will be sent to {order.mobile}</p>
            </>
          )}
        </>
      )}

      {/* ── STAFF ACTIONS ── */}
      {isStaff&&(
        <div style={{display:"flex",gap:10,flexWrap:"wrap",marginTop:6}}>
          {!order.paidAt&&<WaitBox icon="💳" msg="Waiting for customer payment."/>}
          <a href={WHATSAPP(order.mobile,waMsg())} target="_blank" rel="noreferrer"
            style={{display:"inline-block",background:"#25d366",color:"#fff",padding:"10px 22px",borderRadius:10,fontWeight:700,fontSize:13,textDecoration:"none",marginTop:8}}>
            📲 {order.paidAt?"Resend":"Send"} Bill on WhatsApp
          </a>
        </div>
      )}
    </div>
  );
}

const iS={width:"100%",background:"#0d0d0d",border:"1px solid #1e1e1e",color:"#eee",padding:"6px 8px",borderRadius:6,fontSize:12,boxSizing:"border-box"};


function FInput({label,value,onChange,type="text",maxLength,placeholder}){return(<div style={{marginBottom:13}}><label style={{display:"block",color:"#666",fontSize:10,fontWeight:700,letterSpacing:1,textTransform:"uppercase",marginBottom:5}}>{label}</label><input style={{width:"100%",background:"#111",border:"1px solid #1e1e1e",color:"#eee",padding:"10px 13px",borderRadius:10,fontSize:14,boxSizing:"border-box"}} type={type} value={value} maxLength={maxLength} placeholder={placeholder} onChange={e=>onChange&&onChange(e.target.value)}/></div>);}
function ActionBtn({onClick,children,color="#f4c060"}){return(<button style={{background:color==="#f4c060"?"linear-gradient(135deg,#f4c060,#c87820)":color,color:color==="#f4c060"?"#000":"#fff",border:"none",padding:"11px 20px",borderRadius:10,fontSize:13,fontWeight:700,cursor:"pointer",marginTop:4}} onClick={onClick}>{children}</button>);}
function WaitBox({icon,msg}){return(<div style={{background:"#060606",border:"1px solid #161616",borderRadius:12,padding:"22px",textAlign:"center",color:"#555",fontSize:13}}><div style={{fontSize:34,marginBottom:8}}>{icon}</div>{msg}</div>);}
function Toast({toast}){if(!toast)return null;return(<div style={{position:"fixed",top:20,right:20,padding:"12px 22px",borderRadius:10,color:"#fff",fontWeight:700,zIndex:9999,fontSize:13,boxShadow:"0 4px 20px rgba(0,0,0,0.5)",background:toast.type==="error"?"#c0392b":"#2c7"}}>{toast.msg}</div>);}

const base={
  centerPage:{background:"#080808",minHeight:"100vh",display:"flex",flexDirection:"column",alignItems:"center",justifyContent:"center",padding:32,fontFamily:"'Segoe UI',sans-serif",color:"#eee",textAlign:"center"},
  bigCard:(c)=>({background:"#0f0f0f",border:`1px solid ${c}44`,borderRadius:20,padding:"32px 40px",cursor:"pointer",fontSize:20,lineHeight:1.8,color:"#eee",minWidth:180,textAlign:"center"}),
};
