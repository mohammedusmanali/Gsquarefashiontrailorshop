// ── Due date helpers ─────────────────────────────────────────────────────────
const daysUntilDue = (dueDate) => {
  if (!dueDate) return null;
  const now  = new Date(); now.setHours(0,0,0,0);
  const due  = new Date(dueDate); due.setHours(0,0,0,0);
  return Math.round((due - now) / 86400000);
};
const dueBadge = (dueDate, isStaff) => {
  const d = daysUntilDue(dueDate);
  if (d === null) return null;
  if (d < 0)  return { label:`Overdue by ${Math.abs(d)}d`, color:"#ff4444", bg:"#ff444422", icon:"🚨" };
  if (d === 0) return { label:"Due Today!", color:"#ff8800", bg:"#ff880022", icon:"⚠️" };
  if (isStaff && d <= 2) return { label:`Due in ${d}d`, color:"#f4c060", bg:"#f4c06022", icon:"🔔" };
  if (!isStaff && d <= 1) return { label:`Due Tomorrow`, color:"#f4c060", bg:"#f4c06022", icon:"🔔" };
  return { label:`Due ${fmtDateShort(dueDate)}`, color:"#4caf50", bg:"#4caf5015", icon:"📅" };
};

// ── Notification banner logic (shown on load if reminders are due) ───────────
const getDueReminders = (orders, isStaff) =>
  orders.filter(o => o.stage < 11 && o.dueDate).filter(o => {
    const d = daysUntilDue(o.dueDate);
    if (d === null) return false;
    if (isStaff) return d <= 2;
    return d <= 1;
  }).sort((a,b) => daysUntilDue(a.dueDate) - daysUntilDue(b.dueDate));

// ═══════════════════════════════════════════════════════════════════════════
export default function TailorShop() {
  const [route,         setRoute]         = useState(getRoute);
  const [orders,        setOrders]        = useState(loadOrders);
  const [activeOrder,   setActiveOrder]   = useState(null);
  const [customerToken, setCustomerToken] = useState("");
  const [toast,         setToast]         = useState(null);
  const [staffAuthed,   setStaffAuthed]   = useState(()=>sessionStorage.getItem("staff_auth")==="yes");

  useEffect(()=>{ const fn=()=>setRoute(getRoute()); window.addEventListener("hashchange",fn); return()=>window.removeEventListener("hashchange",fn); },[]);

  // Sync across tabs — listen for localStorage changes made by the other portal
  useEffect(()=>{
    const onStorage=(e)=>{
      if(e.key===DB_KEY && e.newValue){
        try {
          const updated = JSON.parse(e.newValue);
          setOrders(updated);
          // Keep activeOrder fresh if it's open
          setActiveOrder(prev=> prev ? (updated.find(o=>o.token===prev.token)||prev) : null);
        } catch {}
      }
    };
    window.addEventListener("storage", onStorage);
    return()=>window.removeEventListener("storage", onStorage);
  },[]);

  // Also poll every 3s as fallback (same-tab iframes or embedded contexts)
  useEffect(()=>{
    const id = setInterval(()=>{
      const fresh = loadOrders();
      setOrders(prev=>{
        // Only update if data actually changed (avoid needless re-renders)
        if(JSON.stringify(prev)===JSON.stringify(fresh)) return prev;
        setActiveOrder(ao=> ao ? (fresh.find(o=>o.token===ao.token)||ao) : null);
        return fresh;
      });
    }, 3000);
    return()=>clearInterval(id);
  },[]);

  useEffect(()=>{ saveOrders(orders); },[orders]);

  const showToast   = (msg,type="success")=>{ setToast({msg,type}); setTimeout(()=>setToast(null),3500); };
  const updateOrder = (token,patch)=>{
    setOrders(prev=>prev.map(o=>o.token===token?{...o,...patch,updatedAt:Date.now()}:o));
    if(activeOrder?.token===token) setActiveOrder(prev=>({...prev,...patch,updatedAt:Date.now()}));
  };
  const navigate    = (path)=>{ window.location.hash=path; };
  const staffLogout = ()=>{ sessionStorage.removeItem("staff_auth"); setStaffAuthed(false); navigate("/staff"); };

  if(route==="denied")  return <AccessDenied navigate={navigate}/>;
  if(route==="staff"){
    if(!staffAuthed) return <StaffLanding onAuth={()=>{ sessionStorage.setItem("staff_auth","yes"); setStaffAuthed(true); }}/>;
    return <StaffPanel orders={orders} setOrders={setOrders} activeOrder={activeOrder} setActiveOrder={setActiveOrder} updateOrder={updateOrder} showToast={showToast} toast={toast} onLogout={staffLogout}/>;
  }
  if(route==="customer") return <CustomerPortal orders={orders} customerToken={customerToken} setCustomerToken={setCustomerToken} updateOrder={updateOrder} showToast={showToast} toast={toast}/>;
}

