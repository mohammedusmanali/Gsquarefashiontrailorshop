                const b=dueBadge(o.dueDate,true);
                return(
                  <div key={o.token} onClick={()=>{ setActiveOrder(o); setView("order"); }} style={{background:"#111",border:`1px solid ${b.color}44`,borderRadius:12,padding:"10px 16px",cursor:"pointer",display:"flex",alignItems:"center",gap:10,flexShrink:0}}>
                    <span style={{fontSize:16}}>{b.icon}</span>
                    <div>
                      <div style={{color:"#eee",fontWeight:700,fontSize:13}}>{o.name} <span style={{color:"#666",fontSize:11}}>#{o.token}</span></div>
                      <div style={{color:b.color,fontSize:12,fontWeight:600}}>{b.label} · {stageInfo(o.stage).label}</div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      )}

      {/* DASHBOARD */}
      {view==="dashboard"&&(
        <div style={{maxWidth:1200,margin:"0 auto",padding:"28px 32px"}}>
          {/* KPIs */}
          <div style={{display:"grid",gridTemplateColumns:"repeat(auto-fill,minmax(170px,1fr))",gap:14,marginBottom:28}}>
            {[
              {icon:"📦",label:"Total Orders",   value:orders.length,            color:"#f4c060"},
              {icon:"🧵",label:"In Production",  value:orders.filter(o=>o.stage>=2&&o.stage<=5).length, color:"#60b4f4"},
              {icon:"👗",label:"Trial Pending",  value:orders.filter(o=>o.stage===6).length,  color:"#c060f4"},
              {icon:"✅",label:"Completed",       value:orders.filter(o=>o.stage===11).length, color:"#4caf50"},
              {icon:"💰",label:"Revenue",         value:`₹${totalRevenue.toLocaleString("en-IN")}`, color:"#ffd700"},
              {icon:"🚨",label:"Overdue",         value:overdueCount,             color:"#ff4444"},
            ].map(k=>(
              <div key={k.label} style={{background:"#0f0f0f",border:"1px solid #161616",borderRadius:16,padding:"18px 20px"}}>
                <div style={{fontSize:24,marginBottom:8}}>{k.icon}</div>
                <div style={{fontSize:24,fontWeight:800,color:k.color,lineHeight:1}}>{k.value}</div>
                <div style={{fontSize:12,color:"#555",marginTop:5}}>{k.label}</div>
              </div>
            ))}
          </div>

          {/* Stage pills */}
          <div style={{background:"#0a0a0a",border:"1px solid #111",borderRadius:14,padding:"16px 22px",marginBottom:24}}>
            <p style={{color:"#444",fontSize:11,letterSpacing:2,textTransform:"uppercase",margin:"0 0 14px",fontWeight:700}}>Orders by Stage</p>
            <div style={{display:"flex",flexWrap:"wrap",gap:8}}>
              {STAGES.filter((_,i)=>i>0).map(st=>(
                <div key={st.id} style={{display:"flex",alignItems:"center",gap:7,background:"#111",border:`1px solid ${stageCounts[st.id]>0?st.color+"44":"#161616"}`,borderRadius:20,padding:"5px 13px"}}>
                  <span style={{fontSize:13}}>{st.icon}</span>
                  <span style={{fontSize:12,color:stageCounts[st.id]>0?st.color:"#444"}}>{st.label}</span>
                  <span style={{background:stageCounts[st.id]>0?st.color:"#1a1a1a",color:stageCounts[st.id]>0?"#000":"#333",borderRadius:20,padding:"1px 7px",fontSize:11,fontWeight:700}}>{stageCounts[st.id]}</span>
                </div>
              ))}
            </div>
          </div>

          {/* Table */}
          <div style={{background:"#0a0a0a",border:"1px solid #111",borderRadius:18,overflow:"hidden"}}>
            <div style={{display:"flex",alignItems:"center",gap:12,padding:"16px 24px",borderBottom:"1px solid #111",flexWrap:"wrap"}}>
              <h3 style={{color:"#eee",fontWeight:700,fontSize:16,margin:0,flex:1}}>All Orders</h3>
              <input style={{background:"#111",border:"1px solid #1e1e1e",color:"#eee",padding:"8px 14px",borderRadius:10,fontSize:13,width:210,boxSizing:"border-box"}} placeholder="🔍 Name, token, mobile…" value={search} onChange={e=>setSearch(e.target.value)}/>
              <button style={{background:"linear-gradient(135deg,#f4c060,#c87820)",color:"#000",border:"none",padding:"9px 18px",borderRadius:10,fontSize:13,fontWeight:700,cursor:"pointer"}} onClick={()=>setView("new")}>➕ New</button>
            </div>
            {filtered.length===0&&<p style={{color:"#444",textAlign:"center",padding:40}}>No orders found.</p>}
            {filtered.map(o=>{
              const st=stageInfo(o.stage);
              const db=dueBadge(o.dueDate,true);
              return(
                <div key={o.token} className="row-hov" style={{display:"grid",gridTemplateColumns:"76px 1fr 130px 140px 100px 80px 36px",alignItems:"center",gap:10,padding:"12px 24px",borderBottom:"1px solid #0f0f0f",cursor:"pointer",transition:"all .15s"}}
                  onClick={()=>{ setActiveOrder(o); setView("order"); }}>
                  <span style={{background:"rgba(244,192,96,0.1)",color:"#f4c060",border:"1px solid rgba(244,192,96,0.2)",padding:"3px 0",borderRadius:8,fontWeight:700,fontSize:12,textAlign:"center"}}>#{o.token}</span>
                  <div>
                    <div style={{color:"#eee",fontWeight:600,fontSize:14}}>{o.name}</div>
                    <div style={{color:"#555",fontSize:11,marginTop:2}}>📱 {o.mobile}</div>
                  </div>
                  <div style={{display:"flex",alignItems:"center",gap:5}}>
                    <span style={{fontSize:14}}>{st.icon}</span>
                    <span style={{fontSize:11,color:st.color,fontWeight:600}}>{st.label}</span>
                  </div>
                  <div>
                    {db?(
                      <span style={{background:db.bg,color:db.color,border:`1px solid ${db.color}44`,borderRadius:20,padding:"3px 10px",fontSize:11,fontWeight:700,whiteSpace:"nowrap"}}>
                        {db.icon} {db.label}
                      </span>
                    ):<span style={{color:"#333",fontSize:12}}>No due date</span>}
                  </div>
                  <div style={{color:o.amount?"#4caf50":"#333",fontSize:13,fontWeight:700}}>{o.amount?`₹${o.amount}`:"—"}</div>
                  <div style={{color:"#444",fontSize:11}}>{fmtDateShort(o.updatedAt)}</div>
                  <div style={{color:"#555",fontSize:18}}>›</div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* NEW ORDER */}
      {view==="new"&&(
        <div style={{maxWidth:600,margin:"48px auto",padding:"0 24px"}}>
          <button style={{background:"transparent",border:"1px solid #222",color:"#888",padding:"8px 16px",borderRadius:8,cursor:"pointer",fontSize:13,marginBottom:24}} onClick={()=>setView("dashboard")}>← Back</button>
          <div style={{background:"#0a0a0a",border:"1px solid #161616",borderRadius:20,overflow:"hidden"}}>
            <div style={{background:"linear-gradient(135deg,rgba(244,192,96,0.07),transparent)",padding:"26px 32px",borderBottom:"1px solid #111"}}>
              <h2 style={{color:"#f4c060",fontWeight:800,fontSize:22,margin:0}}>➕ New Customer Intake</h2>
              <p style={{color:"#555",fontSize:14,margin:"6px 0 0"}}>Register a new customer and set their order due date</p>
            </div>
            <div style={{padding:"26px 32px"}}>
              <FInput label="Customer Name" value={form.name} onChange={v=>setForm(p=>({...p,name:v}))} placeholder="e.g. Priya Sharma"/>
              <FInput label="Mobile Number" value={form.mobile} onChange={v=>setForm(p=>({...p,mobile:v}))} type="tel" maxLength={10} placeholder="10-digit number"/>
              {/* DUE DATE */}
              <div style={{marginBottom:16}}>
                <label style={{display:"block",color:"#666",fontSize:11,fontWeight:700,letterSpacing:1,textTransform:"uppercase",marginBottom:6}}>📅 Due Date <span style={{color:"#f46060"}}>*</span></label>
                <input style={{width:"100%",background:"#111",border:"1px solid #1e1e1e",color:"#eee",padding:"11px 14px",borderRadius:10,fontSize:14,boxSizing:"border-box"}} type="date" value={form.dueDate} min={fmtDateInput(Date.now())} onChange={e=>setForm(p=>({...p,dueDate:e.target.value}))}/>
                <p style={{color:"#555",fontSize:11,margin:"5px 0 0"}}>Staff will be reminded 2 days before · Customer reminded 1 day before</p>
              </div>
              <FInput label="Notes (optional)" value={form.notes} onChange={v=>setForm(p=>({...p,notes:v}))} placeholder="Special requirements…"/>
              <button style={{width:"100%",background:"linear-gradient(135deg,#f4c060,#c87820)",color:"#000",border:"none",padding:"14px",borderRadius:12,fontSize:16,fontWeight:800,cursor:"pointer",marginTop:8}} onClick={createOrder}>Generate Token & Start Order 🎟️</button>
            </div>
          </div>
        </div>
      )}

      {/* ORDER DETAIL */}
      {view==="order"&&activeOrder&&(
        <OrderDetailPage order={activeOrder} updateOrder={updateOrder} showToast={showToast} isStaff={true} onBack={()=>setView("dashboard")}/>
      )}
    </div>
  );
}

// ═══════════════════════════════════════════════════════════════════════════
// ORDER DETAIL PAGE
// ═══════════════════════════════════════════════════════════════════════════
function OrderDetailPage({ order, updateOrder, showToast, isStaff, onBack }) {
  const [meas,setMeas]                   = useState(order.measurements||{});
  const [trialFeedback,setTrialFeedback] = useState(order.trialFeedback||"");
  const [corrNote,setCorrNote]           = useState(order.correctionNote||"");
  const [tailorNote,setTailorNote]       = useState(order.tailorNote||"");
  const [seniorNote,setSeniorNote]       = useState(order.seniorNote||"");
  const [amount,setAmount]               = useState(order.amount||"");
  const [rating,setRating]               = useState(order.rating||0);
  const [comment,setComment]             = useState(order.comment||"");
  const [selDesign,setSelDesign]         = useState(order.design||null);
  const [editDue,setEditDue]             = useState(false);
  const [newDue,setNewDue]               = useState(order.dueDate||"");

  const advance=(nextStage,patch={})=>{
    const h={stage:nextStage,label:STAGES[nextStage]?.label,at:Date.now()};
    updateOrder(order.token,{stage:nextStage,history:[...(order.history||[]),h],...patch});
    showToast(`Moved to: ${STAGES[nextStage]?.label}`);
  };
  const stage=order.stage;
  const st=stageInfo(stage);
  const db=dueBadge(order.dueDate, isStaff);

  return (
    <div style={{background:"#080808",minHeight:"100vh",fontFamily:"'Segoe UI',sans-serif"}}>
      {/* STICKY NAV */}
      <div style={{background:"#0a0a0a",borderBottom:"1px solid #111",padding:"13px 32px",display:"flex",alignItems:"center",gap:14,flexWrap:"wrap",position:"sticky",top:0,zIndex:50}}>
        <button onClick={onBack} style={{background:"transparent",border:"1px solid #222",color:"#888",padding:"7px 15px",borderRadius:8,cursor:"pointer",fontSize:13}}>← {isStaff?"All Orders":"Back"}</button>
        <span style={{background:"rgba(244,192,96,0.1)",color:"#f4c060",border:"1px solid rgba(244,192,96,0.25)",padding:"5px 14px",borderRadius:20,fontWeight:800,fontSize:14}}>#{order.token}</span>
        <span style={{color:"#eee",fontWeight:700,fontSize:15}}>{order.name}</span>
        {db&&(
          <span style={{background:db.bg,color:db.color,border:`1px solid ${db.color}44`,borderRadius:20,padding:"5px 13px",fontSize:12,fontWeight:700}}>
            {db.icon} {db.label}
          </span>
        )}
        <div style={{marginLeft:"auto",display:"flex",alignItems:"center",gap:8,background:`${st.color}18`,border:`1px solid ${st.color}44`,borderRadius:20,padding:"6px 14px"}}>
          <span style={{fontSize:15}}>{st.icon}</span>
          <span style={{color:st.color,fontWeight:700,fontSize:13}}>{st.label}</span>
        </div>
      </div>

      {/* DUE DATE REMINDER BANNER (visible when due soon) */}
      {db && (db.label.includes("Overdue")||db.label.includes("Today")||(isStaff&&daysUntilDue(order.dueDate)<=2)||((!isStaff)&&daysUntilDue(order.dueDate)<=1)) && order.stage<11 && (
        <div style={{background:`linear-gradient(135deg,${db.color}14,transparent)`,borderBottom:`1px solid ${db.color}33`,padding:"14px 32px",display:"flex",alignItems:"center",gap:12}}>
          <span style={{fontSize:22}}>{db.icon}</span>
          <div>
            <div style={{color:db.color,fontWeight:700,fontSize:14}}>
              {db.label.includes("Overdue") ? `⚠️ This order is overdue! Due date was ${fmtDateShort(order.dueDate)}.`
               : db.label.includes("Today") ? `⚠️ This order is due today (${fmtDateShort(order.dueDate)})!`
               : isStaff ? `🔔 Reminder: This order is due on ${fmtDateShort(order.dueDate)} — please ensure it's completed in time.`
               : `🔔 Your blouse is due tomorrow (${fmtDateShort(order.dueDate)}) — we'll have it ready for you!`}
            </div>
            <div style={{color:"#666",fontSize:12,marginTop:2}}>
              {isStaff ? "Staff reminder: 2 days before due date" : "Customer reminder: 1 day before due date"}
            </div>
          </div>
        </div>
      )}

      <div style={{maxWidth:1100,margin:"0 auto",padding:"28px 32px"}}>
        {/* HERO CARD */}
        <div style={{background:`linear-gradient(135deg,${st.color}0e,#0a0a0a)`,border:`1px solid ${st.color}28`,borderRadius:20,padding:"26px 30px",marginBottom:24,display:"flex",alignItems:"center",justifyContent:"space-between",flexWrap:"wrap",gap:16}}>
          <div>
            <div style={{fontSize:11,color:"#555",fontWeight:700,letterSpacing:2,textTransform:"uppercase",marginBottom:8}}>Order Details</div>
            <h2 style={{color:"#fff",fontWeight:900,fontSize:26,margin:"0 0 6px"}}>{order.name}</h2>
            <div style={{display:"flex",gap:20,flexWrap:"wrap",marginTop:10}}>
              {[{l:"Token",v:`#${order.token}`},{l:"Mobile",v:order.mobile},{l:"Created",v:fmtDateShort(order.createdAt)},{l:"Design",v:order.design?.name||"Pending"},{l:"Amount",v:order.amount?`₹${order.amount}`:"Pending"}].map(x=>(
                <div key={x.l} style={{minWidth:80}}>
                  <div style={{color:"#555",fontSize:10,fontWeight:600,letterSpacing:1,textTransform:"uppercase"}}>{x.l}</div>
                  <div style={{color:"#eee",fontWeight:700,fontSize:13,marginTop:2}}>{x.v}</div>
                </div>
              ))}
              {/* DUE DATE inline display / edit */}
              <div style={{minWidth:120}}>
                <div style={{color:"#555",fontSize:10,fontWeight:600,letterSpacing:1,textTransform:"uppercase"}}>Due Date</div>
                {!editDue ? (
                  <div style={{display:"flex",alignItems:"center",gap:6,marginTop:2}}>
                    <span style={{color:db?db.color:"#eee",fontWeight:700,fontSize:13}}>{order.dueDate?fmtDateShort(order.dueDate):"Not set"}</span>
                    {isStaff&&<button onClick={()=>setEditDue(true)} style={{background:"transparent",border:"1px solid #333",color:"#888",padding:"2px 8px",borderRadius:6,cursor:"pointer",fontSize:10}}>✏️ Edit</button>}
                  </div>
                ):(
                  <div style={{display:"flex",alignItems:"center",gap:6,marginTop:2}}>
                    <input type="date" value={newDue} min={fmtDateInput(Date.now())} onChange={e=>setNewDue(e.target.value)} style={{background:"#111",border:"1px solid #333",color:"#eee",padding:"4px 8px",borderRadius:6,fontSize:12}}/>
                    <button onClick={()=>{ updateOrder(order.token,{dueDate:newDue}); setEditDue(false); showToast("Due date updated"); }} style={{background:"#f4c060",color:"#000",border:"none",padding:"4px 10px",borderRadius:6,cursor:"pointer",fontSize:11,fontWeight:700}}>Save</button>
                    <button onClick={()=>setEditDue(false)} style={{background:"transparent",border:"1px solid #333",color:"#888",padding:"4px 8px",borderRadius:6,cursor:"pointer",fontSize:11}}>✕</button>
                  </div>
                )}
              </div>
            </div>
          </div>
          <div style={{display:"flex",flexDirection:"column",alignItems:"flex-end",gap:6}}>
            <div style={{fontSize:44}}>{st.icon}</div>
            <div style={{color:st.color,fontWeight:800,fontSize:15}}>{st.label}</div>
            <div style={{color:"#555",fontSize:12}}>Stage {stage} of 11</div>
          </div>
        </div>

        {/* PIPELINE PROGRESS */}
        <div style={{background:"#0a0a0a",border:"1px solid #111",borderRadius:16,padding:"18px 22px",marginBottom:24}}>
          <p style={{color:"#555",fontSize:11,fontWeight:700,letterSpacing:2,textTransform:"uppercase",margin:"0 0 14px"}}>Order Progress</p>
          <div style={{display:"flex",alignItems:"center",overflowX:"auto",paddingBottom:4}}>
            {STAGES.map((s,i)=>(
              <div key={s.id} style={{display:"flex",alignItems:"center",flex:i<STAGES.length-1?1:0}}>
                <div title={s.label} style={{display:"flex",flexDirection:"column",alignItems:"center",gap:3,flexShrink:0,padding:"2px 0"}}>
                  <div style={{width:30,height:30,borderRadius:"50%",background:s.id<stage?"#4caf50":s.id===stage?st.color:"#1a1a1a",border:`2px solid ${s.id<stage?"#4caf50":s.id===stage?st.color:"#222"}`,display:"flex",alignItems:"center",justifyContent:"center",fontSize:13,transform:s.id===stage?"scale(1.2)":"scale(1)",transition:"all .3s",flexShrink:0}}>
                    {s.id<stage?"✓":s.icon}
                  </div>
                  {s.id===stage&&<div style={{fontSize:9,color:st.color,fontWeight:700,whiteSpace:"nowrap",marginTop:2}}>{s.label}</div>}
                </div>
                {i<STAGES.length-1&&<div style={{height:3,flex:1,minWidth:6,background:s.id<stage?"#4caf5055":"#1a1a1a",margin:"0 2px",marginBottom:s.id===stage?14:0,transition:"all .3s"}}/>}
              </div>
            ))}
          </div>
        </div>

        <div style={{display:"grid",gridTemplateColumns:"1fr 320px",gap:22,alignItems:"start"}}>
          {/* LEFT: ACTION */}
          <div>
            <div style={{background:"#0a0a0a",border:`1px solid ${st.color}28`,borderRadius:18,overflow:"hidden",marginBottom:18}}>
              <div style={{background:`linear-gradient(135deg,${st.color}0d,transparent)`,padding:"16px 22px",borderBottom:`1px solid ${st.color}18`,display:"flex",alignItems:"center",gap:10}}>
                <span style={{fontSize:20}}>{st.icon}</span>
                <div>
                  <h3 style={{color:st.color,fontWeight:800,fontSize:15,margin:0}}>Current Stage: {st.label}</h3>
                  <p style={{color:"#555",fontSize:12,margin:"3px 0 0"}}>{isStaff?"Staff action required":"Awaiting your action"}</p>
                </div>
              </div>
              <div style={{padding:"20px 22px"}}>
                <StageActions stage={stage} order={order} isStaff={isStaff} meas={meas} setMeas={setMeas} tailorNote={tailorNote} setTailorNote={setTailorNote} seniorNote={seniorNote} setSeniorNote={setSeniorNote} trialFeedback={trialFeedback} setTrialFeedback={setTrialFeedback} corrNote={corrNote} setCorrNote={setCorrNote} amount={amount} setAmount={setAmount} rating={rating} setRating={setRating} comment={comment} setComment={setComment} selDesign={selDesign} setSelDesign={setSelDesign} advance={advance} updateOrder={updateOrder} showToast={showToast}/>
              </div>
            </div>

            {order.measurements&&Object.keys(order.measurements).length>0&&(
              <div style={{background:"#0a0a0a",border:"1px solid #111",borderRadius:16,padding:"18px 22px",marginBottom:18}}>
                <h4 style={{color:"#f4c060",fontWeight:700,margin:"0 0 14px",fontSize:14}}>📏 Measurements</h4>
                <div style={{display:"grid",gridTemplateColumns:"repeat(auto-fill,minmax(120px,1fr))",gap:10}}>
                  {Object.entries(order.measurements).map(([k,v])=>(
                    <div key={k} style={{background:"#111",border:"1px solid #1a1a1a",borderRadius:10,padding:"10px 12px"}}>
                      <div style={{color:"#555",fontSize:10,fontWeight:700,letterSpacing:1,textTransform:"uppercase"}}>{k}</div>
                      <div style={{color:"#f4c060",fontWeight:800,fontSize:18,marginTop:3}}>{v}<span style={{color:"#666",fontSize:11,fontWeight:400}}>"</span></div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {order.design&&(
              <div style={{background:"#0a0a0a",border:"1px solid #111",borderRadius:16,padding:"18px 22px"}}>
                <h4 style={{color:"#f4c060",fontWeight:700,margin:"0 0 12px",fontSize:14}}>🎨 Selected Design</h4>
                <div style={{display:"flex",gap:14,alignItems:"center",flexWrap:"wrap"}}>
                  <img src={order.design.img} alt={order.design.name} style={{width:96,height:66,objectFit:"cover",borderRadius:10,flexShrink:0}} onError={e=>e.target.src="https://via.placeholder.com/96x66?text=Design"}/>
                  <div>
                    <div style={{color:"#fff",fontWeight:700,fontSize:15}}>{order.design.name}</div>
                    <div style={{color:"#f4c060",fontSize:12,marginTop:3}}>{order.design.style}</div>
                    <div style={{color:"#666",fontSize:13,marginTop:3}}>{order.design.desc}</div>
                  </div>
                </div>
              </div>
            )}
          </div>

          {/* RIGHT: SIDEBAR */}
          <div>
            {/* SUMMARY */}
            <div style={{background:"#0a0a0a",border:"1px solid #111",borderRadius:16,padding:"18px 20px",marginBottom:16}}>
              <h4 style={{color:"#eee",fontWeight:700,margin:"0 0 14px",fontSize:14}}>📋 Order Summary</h4>
              {[
                {l:"Token",    v:`#${order.token}`},
                {l:"Customer", v:order.name},
                {l:"Mobile",   v:order.mobile},
                {l:"Created",  v:fmtDate(order.createdAt)},
                {l:"Due Date", v:order.dueDate?fmtDateShort(order.dueDate):"Not set", special: db},
                {l:"Stage",    v:st.label},
                {l:"Amount",   v:order.amount?`₹${order.amount}`:"Not billed"},
                {l:"Payment",  v:order.paymentMethod||"Pending"},
                {l:"Bill Sent",v:order.billSent?"✅ WhatsApp Sent":"Not yet"},
                {l:"Rating",   v:order.rating?`${order.rating}/5 ⭐`:"Not rated"},
              ].map(x=>(
                <div key={x.l} style={{display:"flex",justifyContent:"space-between",alignItems:"center",padding:"7px 0",borderBottom:"1px solid #0f0f0f"}}>
                  <span style={{color:"#555",fontSize:12}}>{x.l}</span>
                  <span style={{color:x.special?x.special.color:"#eee",fontSize:12,fontWeight:600,textAlign:"right",maxWidth:160}}>{x.v}</span>
                </div>
              ))}
              {order.notes&&<div style={{marginTop:10,background:"#111",borderRadius:8,padding:"9px 11px"}}><div style={{color:"#555",fontSize:10,marginBottom:3}}>NOTES</div><div style={{color:"#aaa",fontSize:12}}>{order.notes}</div></div>}
            </div>

            {/* TIMELINE */}
            <div style={{background:"#0a0a0a",border:"1px solid #111",borderRadius:16,padding:"18px 20px"}}>
              <h4 style={{color:"#eee",fontWeight:700,margin:"0 0 14px",fontSize:14}}>📜 Timeline</h4>
              {(order.history||[]).map((h,i)=>{
                const hst=stageInfo(h.stage);
                return(
                  <div key={i} style={{display:"flex",gap:10,alignItems:"flex-start",paddingBottom:i<(order.history.length-1)?14:0}}>
                    <div style={{display:"flex",flexDirection:"column",alignItems:"center",flexShrink:0}}>
                      <div style={{width:26,height:26,borderRadius:"50%",background:`${hst.color}1a`,border:`1px solid ${hst.color}44`,display:"flex",alignItems:"center",justifyContent:"center",fontSize:12}}>{hst.icon}</div>
                      {i<(order.history.length-1)&&<div style={{width:1,flex:1,background:"#161616",minHeight:10,marginTop:3}}/>}
                    </div>
                    <div style={{paddingTop:3}}>
